চলক মোড = 10 % 3;
প্ৰকাশ "10 % 3 = ";
প্ৰকাশ মোড;

চলক এণ্ড = 5 & 3;
প্ৰকাশ "5 & 3 = ";
প্ৰকাশ এণ্ড;

চলক অৰ = 5 | 3;
প্ৰকাশ "5 | 3 = ";
প্ৰকাশ অৰ;

চলক এক্সঅৰ = 5 ^ 3;
প্ৰকাশ "5 ^ 3 = ";
প্ৰকাশ এক্সঅৰ;

চলক নট = ~5;
প্ৰকাশ "~5 = ";
প্ৰকাশ নট;

চলক বাওঁ = 1 << 4;
প্ৰকাশ "1 << 4 = ";
প্ৰকাশ বাওঁ;

চলক সোঁ = 32 >> 3;
প্ৰকাশ "32 >> 3 = ";
প্ৰকাশ সোঁ;

// Math
প্ৰকাশ "sin(0) = ";
প্ৰকাশ sin(0);
প্ৰকাশ "cos(0) = ";
প্ৰকাশ cos(0);
প্ৰকাশ "sqrt(16) = ";
প্ৰকাশ sqrt(16);
প্ৰকাশ "floor(4.7) = ";
প্ৰকাশ floor(4.7);
প্ৰকাশ "ceil(4.2) = ";
প্ৰকাশ ceil(4.2);

// Strings
চলক নাম = "Tupal";
প্ৰকাশ "str_len: ";
প্ৰকাশ str_len(নাম);
প্ৰকাশ "char_at: ";
প্ৰকাশ char_at(নাম, 1);
প্ৰকাশ "substring: ";
প্ৰকাশ substring(নাম, 1, 3);

// Dynamic arrays / byte arrays
চলক বাফাৰ = byte_array_new(10);
বাফাৰ[0] = 255;
বাফাৰ[5] = 128;
প্ৰকাশ "buffer[0]: ";
প্ৰকাশ বাফাৰ[0];
প্ৰকাশ "buffer[5]: ";
প্ৰকাশ বাফাৰ[5];

// Map
চলক মেপ = map_new();
মেপ["key1"] = "val1";
মেপ[42] = "val42";
প্ৰকাশ "map[key1]: ";
প্ৰকাশ মেপ["key1"];
প্ৰকাশ "map[42]: ";
প্ৰকাশ মেপ[42];
প্ৰকাশ "map keys list: ";
প্ৰকাশ map_keys(মেপ);
প্ৰকাশ "map_has 42: ";
প্ৰকাশ map_has(মেপ, 42);
map_delete(মেপ, 42);
প্ৰকাশ "map_has 42 after delete: ";
প্ৰকাশ map_has(মেপ, 42);
