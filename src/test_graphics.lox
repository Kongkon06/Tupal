// Tupal Graphics Test Script
প্ৰকাশ "পৰ্দা খোলা হৈছে...";

চলক প্রস্থ = 320;
চলক উচ্চতা = 200;

চলক সঁচা_হয় = window_init(প্রস্থ, উচ্চতা, "Tupal Software Renderer Test");

যদি (!সঁচা_হয়) {
  প্ৰকাশ "পৰ্দা খুলিব পৰা নগ'ল।";
} নহলে {
  চলক আকাৰ = প্রস্থ * উচ্চতা * 4;
  চলক বাফাৰ = byte_array_new(আকাৰ);

  চলক বৰ্গ_x = 150;
  চলক বৰ্গ_y = 90;
  চলক বৰ্গ_আকাৰ = 20;

  চলক চলি_থাকিব = সঁচা;

  যেতিয়া (চলি_থাকিব) {
    // W = 87, A = 65, S = 83, D = 68
    // Up = 38, Left = 37, Down = 40, Right = 39
    // Escape = 27
    যদি (key_pressed(27)) {
      চলি_থাকিব = মিছা;
    }
    যদি (key_pressed(87) অথবা key_pressed(38)) {
      বৰ্গ_y = বৰ্গ_y - 2;
    }
    যদি (key_pressed(83) অথবা key_pressed(40)) {
      বৰ্গ_y = বৰ্গ_y + 2;
    }
    যদি (key_pressed(65) অথবা key_pressed(37)) {
      বৰ্গ_x = বৰ্গ_x - 2;
    }
    যদি (key_pressed(68) অথবা key_pressed(39)) {
      বৰ্গ_x = বৰ্গ_x + 2;
    }

    // বৰ্গটো পৰ্দাৰ ভিতৰত ৰাখক
    যদি (বৰ্গ_x < 0) বৰ্গ_x = 0;
    যদি (বৰ্গ_x > প্রস্থ - বৰ্গ_আকাৰ) {
      বৰ্গ_x = প্রস্থ - বৰ্গ_আকাৰ;
    }
    যদি (বৰ্গ_y < 0) বৰ্গ_y = 0;
    যদি (বৰ্গ_y > উচ্চতা - বৰ্গ_আকাৰ) {
      বৰ্গ_y = উচ্চতা - বৰ্গ_আকাৰ;
    }

    // বাফাৰটো পৰিষ্কাৰ কৰক (নীলা ৰং)
    চলক i = 0;
    যেতিয়া (i < প্রস্থ * উচ্চতা) {
      চলক offset = i * 4;
      বাফাৰ[offset] = 20;     // R
      বাফাৰ[offset+1] = 40;   // G
      বাফাৰ[offset+2] = 100;  // B
      বাফাৰ[offset+3] = 255;  // A
      i = i + 1;
    }

    // এটা ৰঙা বৰ্গ আকক
    চলক y_offset = 0;
    যেতিয়া (y_offset < বৰ্গ_আকাৰ) {
      চলক x_offset = 0;
      যেতিয়া (x_offset < বৰ্গ_আকাৰ) {
        চলক px = বৰ্গ_x + x_offset;
        চলক py = বৰ্গ_y + y_offset;
        চলক offset = (py * প্রস্থ + px) * 4;
        বাফাৰ[offset] = 255;   // R
        বাফাৰ[offset+1] = 0;   // G
        বাফাৰ[offset+2] = 0;   // B
        বাফাৰ[offset+3] = 255; // A
        x_offset = x_offset + 1;
      }
      y_offset = y_offset + 1;
    }

    // মাউছৰ স্থান পৰীক্ষা কৰক আৰু তাত হালধীয়া বিন্দু আকক
    চলক mx = mouse_x();
    চলক my = mouse_y();
    যদি (mx >= 0 আৰু mx < প্রস্থ আৰু my >= 0 আৰু my < উচ্চতা) {
      চলক m_offset = (my * প্রস্থ + mx) * 4;
      বাফাৰ[m_offset] = 255;
      বাফাৰ[m_offset+1] = 255;
      বাফাৰ[m_offset+2] = 0;
      বাফাৰ[m_offset+3] = 255;
    }

    // পৰ্দাত প্ৰদৰ্শন কৰক
    চলক সফল = window_update(বাফাৰ);
    যদি (!সফল) {
      চলি_থাকিব = মিছা;
    }

    sleep(0.016);
  }

  window_close();
}
প্ৰকাশ "বিদায়!";
